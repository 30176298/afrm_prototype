{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG"
      }
    },
    {
      "name": "asan",
      "displayName": "GCC Debug + AddressSanitizer/UBSan (Linux)",
      "inherits": "gcc-debug",
      "cacheVariables": { "AFRM_SANITIZE": "ON" }
    },
    {
      "name": "msvc",
      "displayName": "MSVC (Visual Studio generator)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "gcc-debug",   "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "asan",        "configurePreset": "asan" },
    { "name": "msvc",        "configurePreset": "msvc", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "gcc-debug",   "configurePreset": "gcc-debug",   "output": { "outputOnFailure": true } },
    { "name": "gcc-release", "configurePreset": "gcc-release", "output": { "outputOnFailure": true } },
    { "name": "asan",        "configurePreset": "asan",        "output": { "outputOnFailure": true } },
    { "name": "msvc",        "configurePreset": "msvc",        "configuration": "Release",
      "output": { "outputOnFailure": true } }
  ]
}
